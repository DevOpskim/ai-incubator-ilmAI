# Copy to .env on the EC2 instance (never commit .env).
# All of these become container env vars at runtime via env_file in docker-compose.yaml.

# Docker image namespace (your Docker Hub username)
DOCKER_USERNAME=your-dockerhub-username

# PostgreSQL — change both POSTGRES_* vars AND DATABASE_URL to match
POSTGRES_USER=ilm_ai_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=ilm_ai

# Docker Compose on EC2 (Postgres service name `db` in docker-compose.yaml)
DATABASE_URL=postgresql://ilm_ai_user:replace_with_strong_password@db:5432/ilm_ai

# Amazon RDS (recommended when you outgrow compose Postgres)
# DATABASE_URL=postgresql://user:pass@your-rds-endpoint.region.rds.amazonaws.com:5432/ilm_ai

# Domain for Caddy reverse proxy (leave empty to disable TLS / use HTTP only)
# CADDY_DOMAIN=ilmai.yourdomain.com

# Internal URL the frontend BFF uses to reach the FastAPI backend (Docker network)
BACKEND_INTERNAL_URL=http://backend:8000

JWT_SECRET=replace_with_random_secret
OPENAI_API_KEY=sk-your-openai-key-here

# SMTP for OTP email verification (leave host empty to print OTP to logs instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
STRIPE_SECRET_KEY=sk_test_your-stripe-key

# Google OAuth (optional for MVP)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
